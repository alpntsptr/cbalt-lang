{
    "configurations": [
        {
            "name": "CBALT",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/build/_deps/llvm-src/**",
                "/usr/lib/llvm-14/include"
            ],
            "defines": [
                "LLVM_STATIC_LIBS=ON"
            ],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-clang-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}/include",
                    "${workspaceFolder}/build/**"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}